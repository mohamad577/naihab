rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Chaque profil utilisateur est identifié par son UID Firebase
    match /utilisateurs/{userId} {
      // N'importe quel utilisateur connecté peut LIRE un profil
      // (nécessaire pour afficher les profils des autres, la recherche, etc.)
      allow read: if request.auth != null;

      // Seul le propriétaire du compte peut MODIFIER son propre profil
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Publications (posts photo) visibles par tout le monde
    match /publications/{postId} {
      // Tout utilisateur connecté peut voir toutes les publications
      allow read: if request.auth != null;

      // Seul l'auteur peut créer une publication en son nom
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;

      // Autorisé temporairement à tout utilisateur connecté (pour les likes) —
      // sera restreint proprement quand les likes passeront en sous-collection
      // avec prévention des doublons (semaine "likes et commentaires réels")
      allow update: if request.auth != null;

      // Seul l'auteur peut supprimer sa publication
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // Commentaires réels, liés à chaque publication
      match /commentaires/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }
  }
}
